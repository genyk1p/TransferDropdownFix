<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>TransferDropdownFix</AssemblyName>
    <RootNamespace>TransferDropdownFix</RootNamespace>
    <Version>0.1.2</Version>
    <Product>Transfer Dropdown Fix</Product>
    <Description>Konstruction resource transfer window: vessel names in the closed drop-downs.</Description>
    <Copyright>Copyright (c) 2026 Geny, GPL-3.0</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The built DLL goes straight into the release layout. -->
    <OutputPath>..\GameData\TransferDropdownFix\Plugins\</OutputPath>
  </PropertyGroup>

  <!-- KSP install: override with the KSPDIR environment variable or /p:KSPDIR=... -->
  <PropertyGroup>
    <KSPDIR Condition="'$(KSPDIR)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSPDIR>
    <KSPManaged>$(KSPDIR)\KSP_x64_Data\Managed</KSPManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compile-time references only: nothing from here is copied to the output. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSPManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KSPManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(KSPManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KSPManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KonstructionUI">
      <HintPath>$(KSPDIR)\GameData\UmbraSpaceIndustries\Konstruction\KonstructionUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="USIToolsUI">
      <HintPath>$(KSPDIR)\GameData\000_USITools\USIToolsUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(KSPDIR)\GameData\000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
